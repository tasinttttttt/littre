    "sens": [
      {
        "num": null,
        "mot": "XÉNIE",
        "entete": "<div class=\"entry-entete\">\n\t<span class=\"entry-prononciation\">ksé-nie</span>\n\t<span class=\"entry-nature\">s. m.</span>\n</div>\n",
        "html": "\n<div class=\"entry-variante\">Épigramme littéraire ou philosophique, ordinairement en deux vers ; mot très connu en Allemagne à cause du recueil de xénies qu'ont donné en commun Schiller et Gœthe.\n</div>\n\n"
