  "xenodoque": {
    "mot": "XÉNODOQUE",
    "sens": [
      {
        "num": null,
        "mot": "XÉNODOQUE",
        "entete": "<div class=\"entry-entete\">\n\t<span class=\"entry-prononciation\">ksé-no-do-k'</span>\n\t<span class=\"entry-nature\">s. m.</span>\n</div>\n",
        "html": "\n<div class=\"entry-variante\"><span class=\"entry-domaine\">Terme d'antiquité.</span> Local destiné à recevoir et à loger les étrangers.\n<blockquote class=\"entry-citation\">A côté [des ruines romaines de Merida] se trouvaient des atriums, des palais, des monastères, des hôpitaux, des xénodoques, des basiliques, des baptistères, toute sorte de constructions somptueuses, enrichies des produits les plus précieux de l'art et de l'industrie wisigothe <cite><span class=\"cit-ref\">Journ. des Débats, 7 août 1876, 3e page, 5e col.</span></cite></blockquote>\n</div>\n\n"
      }
    ]
  },
