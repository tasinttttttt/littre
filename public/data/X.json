  "xerophagie": {
    "mot": "XÉROPHAGIE",
    "sens": [
      {
        "num": null,
        "mot": "XÉROPHAGIE",
        "entete": "<div class=\"entry-entete\">\n\t<span class=\"entry-prononciation\">ksé-ro-fa-jie</span>\n\t<span class=\"entry-nature\">s. f.</span>\n</div>\n",
