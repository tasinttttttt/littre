        "entete": "<div class=\"entry-entete\">\n\t<span class=\"entry-prononciation\">val-al-la</span>\n\t<span class=\"entry-nature\">s. f.</span>\n</div>\n",
        "html": "\n<div class=\"entry-variante\">Nom, dans la religion des anciens Scandinaves, du paradis d'Odin.\n</div>\n\n"
      }
    ]
  },
  "wali": {
    "mot": "WALI",
    "sens": [
      {
        "num": null,
        "mot": "WALI",
        "entete": "<div class=\"entry-entete\">\n\t<span class=\"entry-prononciation\">oua-li</span>\n\t<span class=\"entry-nature\">s. m.</span>\n</div>\n",
        "html": "\n<div class=\"entry-variante\">Titre des gouverneurs arabes de l'Espagne, au moyen âge.\n</div>\n\n"
      }
    ]
