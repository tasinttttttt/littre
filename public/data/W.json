  "watergang": {
    "mot": "WATERGANG",
    "sens": [
      {
        "num": null,
        "mot": "WATERGANG",
        "entete": "<div class=\"entry-entete\">\n\t<span class=\"entry-prononciation\">oua-tèr-gan</span>, ou WATREGAN (oua-tre-gan)\n\t<span class=\"entry-nature\">s. m.</span>\n</div>\n",
        "html": "\n<div class=\"entry-variante\">Petits canaux pratiqués dans le littoral de la Flandre et des Pays-Bas, et où entrent les embarcations pour pénétrer dans les terres.\n<div class=\"entry-indent\">Canal ou fossé plein d'eau, qui sert à séparer les héritages, ou pour aller d'une ville à l'autre, ou pour le desséchement des marais.\n</div>\n<div class=\"entry-indent\">Fossé rempli d'eau bourbeuse et de bourbe.\n</div>\n</div>\n\n"
      }
    ]
  },
  "waterie": {
    "mot": "WATERIE",
    "sens": [
