        "entete": "<div class=\"entry-entete\">\n\t<span class=\"entry-prononciation\">va-go-nè-t'</span>\n\t<span class=\"entry-nature\">s. f.</span>\n</div>\n",
        "html": "\n<div class=\"entry-variante\">Sorte de voiture.\n<blockquote class=\"entry-citation\">Voitures, coupé, landau, calèche, phaéton, wagonnette, victoria <cite><span class=\"cit-ref\">Journ. offic. Ann. 9 déc. 1871</span></cite></blockquote>\n</div>\n\n"
