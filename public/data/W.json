        "html": "\n<div class=\"entry-variante\">\n<blockquote class=\"entry-citation\">Perches en chêne dépouillé d'écorce ; on les emploie à divers usages <cite><span class=\"cit-ref\">Tarif des douanes, 1844, note 215</span></cite></blockquote>\n</div>\n\n"
      }
    ]
  },
  "wakouf": {
    "mot": "WAKOUF",
    "sens": [
      {
        "num": null,
