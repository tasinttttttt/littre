        "html": "\n<div class=\"entry-variante\">\n<blockquote class=\"entry-citation\">Nom, dans le Pas-de-Calais, d'un mélange de fèves et de pois <cite><span class=\"cit-ref\">les Primes d'honneur, Paris, 1869, p. 81</span></cite></blockquote>\n</div>\n\n"
      }
    ]
  },
  "wateringue": {
    "mot": "WATERINGUE",
    "sens": [
